{
  "name": "yxcr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen": "node scripts/sync-seo.mjs && node scripts/build-site.mjs",
    "dev": "pnpm gen && vitepress dev site --port 3002",
    "build": "pnpm gen && node --max-old-space-size=6144 node_modules/vitepress/bin/vitepress.js build site && node scripts/check-site.mjs",
    "preview": "vitepress preview site --port 3002",
    "preview:worker": "wrangler dev --port 8787",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@mdit/plugin-katex": "^1.1.5",
    "@types/node": "^20",
    "katex": "^0.16.47",
    "typescript": "^5",
    "vitepress": "2.0.0-alpha.21",
    "wrangler": "^4.153.0"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module"
}
