# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# cloudflare
/.wrangler/
.dev.vars*
!.dev.vars.example

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# pnpm
.pnpm-lock.yaml
.pnpm-store


# typescript
*.tsbuildinfo
.pnpm-store/
.tmp-resources/

# vitepress (pages generated by scripts/build-site.mjs)
/site/learn/
/site/topics/
/site/library/
/site/.vitepress/generated/
/site/.vitepress/cache/
/site/.vitepress/dist/
/site/library.md
