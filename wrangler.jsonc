{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yxcr",
  "account_id": "268729d711fadbb19006ad3ec3b26c32",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-27",
  "minify": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "yxcr.top", "custom_domain": true }
  ],
  "assets": {
    "directory": "site/.vitepress/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/questions/*", "/resources", "/overview", "/today", "/practice",
      "/saved", "/notes", "/profile", "/library", "/library/*", "/topics/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
